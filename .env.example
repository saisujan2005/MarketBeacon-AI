# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/marketbeacon

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email Notifications (Resend / SendGrid) ──────────────────────────────────
# resend.com key (Preferred)
RESEND_API_KEY=re_your_resend_api_key
# sendgrid.com key (Fallback)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ── Browser Web Push (PWA) ───────────────────────────────────────────────────
# Generate VAPID key pairs using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BDp_k9sL_V8oD4p3o39WGdyb3FY3miM1xjKhA2wGcGFXpZSUrAm
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_CLAIMS_EMAIL=alerts@marketbeacon.ai

# ── Twitter/X Adaptive Scraper (Optional) ───────────────────────────────────
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# ── Scheduler Configurations ──────────────────────────────────────────────────
NEWS_INTERVAL_MINUTES=10
TWITTER_MARKET_HOURS_INTERVAL=2
TWITTER_OFF_HOURS_INTERVAL=15
MARKET_OPEN_HOUR=9
MARKET_CLOSE_HOUR=16

# ── Alert Engine Threshold ────────────────────────────────────────────────────
# NOTE: ALERT_THRESHOLD is legacy and is NOT read by the application. The alert
# engine uses ALERT_IMPORTANCE_THRESHOLD (default 80). Left here so existing
# deployments keep working unchanged.
ALERT_THRESHOLD=85
# ALERT_IMPORTANCE_THRESHOLD=80

# ── App Environments ──────────────────────────────────────────────────────────
APP_ENV=development

# Comma-separated list of allowed frontend origins (used as the CORS allowlist).
FRONTEND_URL=http://localhost:5173

# REQUIRED IN PRODUCTION. The app refuses to start without it when
# APP_ENV=production, and rejects secrets shorter than 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ── Uploads ───────────────────────────────────────────────────────────────────
# Directory for uploaded research documents. Defaults to backend/uploads.
# Set an absolute path on Render (e.g. a mounted disk) to persist uploads.
# UPLOAD_DIR=/var/data/uploads
MAX_UPLOAD_MB=25

# ── Optional: initial administrator bootstrap ────────────────────────────────
# Both must be set for an admin account to be created on startup. Nothing is
# created otherwise. Unset these again once the account exists.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# ── Optional: startup cache warming ──────────────────────────────────────────
# Off by default. When True, the server generates research dossiers via the LLM
# on every boot, which is slow and costs API credits.
ENABLE_STARTUP_PRELOAD=False

# Set to True on memory-constrained servers (like Render's free 512MB tier)
# to disable local PyTorch/transformers/spaCy models and use fast fallbacks.
DISABLE_LOCAL_ML=False

